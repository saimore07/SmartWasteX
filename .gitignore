# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C-extension / Build artifacts
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Python Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Environment Variables & Secrets
.env
*.env
.env.*
!.env.example

# IDEs & Text Editors
.idea/
.vscode/
*.swp
*.swo
*~

# Operating System Metadata
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# Testing, Profiling & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Application Logs & Crash Dumps
*.log
*.pid

# Local SQLite Database & Ephemeral Instance Data
instance/*
!instance/.gitkeep
*.db
*.sqlite3
*.backup

# Ephemeral Uploads & Dynamic QR Codes (Preserve samples and .gitkeep)
static/uploads/*
!static/uploads/.gitkeep
!static/uploads/samples/
!static/uploads/samples/*
static/qr_codes/*
!static/qr_codes/.gitkeep
!static/qr_codes/EW-2026-*.png
