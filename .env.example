# SmartWasteX — Environment Variables Template
# Copy this file to .env for local overrides (never commit actual .env with real secrets)

# Flask Security
SECRET_KEY=change-this-in-production-generate-secure-random-key
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5000

# Database Configuration
# Default: sqlite:///instance/smartwastex.db
# For Render PostgreSQL: postgresql://username:password@hostname:5432/dbname
DATABASE_URL=sqlite:///instance/smartwastex.db

# Storage & Upload Limits (Memory Optimization for Render 512 MB RAM)
MAX_CONTENT_LENGTH=5242880
MAX_IMAGE_DIMENSION=1280
UPLOAD_FOLDER=static/uploads
QR_FOLDER=static/qr_codes

# AI YOLOv8 Inference Settings
YOLO_IMGSZ=416
INFERENCE_LOCK_TIMEOUT=15.0

# IoT Hardware Sensor Gateway Authentication Key
# Used for X-API-Key authentication on POST /api/iot/bin-update & /api/iot/telemetry
IOT_API_KEY=smartwastex-iot-device-key-2026
